# Aero3D Intelligence Environment Configuration

# Server Settings
PORT=5000
NODE_ENV=development

# Photogrammetry Reconstruction Provider (demo | polycam)
RECONSTRUCTION_PROVIDER=demo

# Polycam API Credentials (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Requires an active Polycam API / Enterprise Subscription
POLYCAM_API_TOKEN=
POLYCAM_BASE_URL=https://poly.cam/api/v1
POLYCAM_WEBHOOK_SECRET=your_webhook_signing_secret_here

# AI Intelligence Service Key
AI_API_KEY=

# Persistence Database Connection (PostgreSQL / Supabase)
DATABASE_URL=
