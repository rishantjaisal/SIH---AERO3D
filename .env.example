# Aero3D Intelligence Environment Configuration

# Server Settings
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed browser origins (leave empty to allow only same-origin / dev proxy)
# Example: CORS_ORIGIN=http://localhost:3000,https://your-site.netlify.app
CORS_ORIGIN=http://localhost:3000

# Reconstruction engine: demo | colmap | polycam
# (RECONSTRUCTION_ENGINE and RECONSTRUCTION_PROVIDER are still read as legacy fallbacks)
PHOTOGRAMMETRY_ENGINE=demo

# Video frame sampling rate (frames per second) used by FFmpeg
FRAME_RATE=3

# COLMAP executable (only used when PHOTOGRAMMETRY_ENGINE=colmap)
# COLMAP_PATH=C:/COLMAP/bin/colmap.exe

# Polycam API Credentials (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Requires an active Polycam API / Enterprise Subscription
POLYCAM_API_TOKEN=
POLYCAM_BASE_URL=https://poly.cam/api/v1
POLYCAM_WEBHOOK_SECRET=your_webhook_signing_secret_here

# AI Intelligence Service Key
AI_API_KEY=

# Persistence Database Connection (PostgreSQL / Supabase)
DATABASE_URL=
